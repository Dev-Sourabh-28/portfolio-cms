generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  password    String
  createdAt   DateTime @default(now())
  portfolios Portfolio[]
}

model Portfolio {
  id              String    @id @default(cuid())
  title           String
  slug            String    @unique
  subtitle        String?
  bio             String?

  yearsExperience Int?
  clientsHandled  Int?

  techStack       String[]

  theme           String    @default("minimal")

  profilePhotoUrl String?
  resumeImageUrl  String?
  resumeUrl       String?
  bestProjectUrl  String?

  titleStyle      Json?
  subtitleStyle   Json?
  bioStyle        Json?

  projectImageStyle Json?
  profileImageStyle Json?

  userId          String
  user            User      @relation(fields: [userId], references: [id])

  projects        Project[]
  customFields    CustomField[]

  createdAt       DateTime  @default(now())
}

model Project {
  id               String   @id @default(cuid())
  title            String
  description      String
  githubUrl        String?
  liveUrl          String?

  techStack        String[]
  imageUrl         String?
  imageUrls        String[]      @default([])

  titleStyle       Json?
  descriptionStyle Json?

  portfolioId      String
  portfolio        Portfolio @relation(fields: [portfolioId], references: [id])

  createdAt        DateTime  @default(now())
}

model CustomField {
  id          String   @id @default(cuid())
  type        String   // paragraph, orderedList, unorderedList, heading
  content     Json     // Rich text content
  order       Int      // Position in the portfolio
  style       Json?    // Styling options (fontFamily, fontSize, fontWeight, fontStyle, color)
  isVisible   Boolean  @default(true) // For built-in fields visibility

  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
}
